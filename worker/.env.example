GATEWAY_URL=https://i15a108.p.ssafy.io/ai
WORKER_API_KEY=<EC2 .env의 WORKER_API_KEY와 동일한 값>

# CatVTON 워커 전용, 생략 시 기본값(worker/ 기준 models/catvton) 사용
CATVTON_CODE_PATH=/path/to/worker/models/catvton

# 가중치가 이미 로컬 HF 캐시에 있을 때만 켠다 — snapshot_download/from_pretrained가 HF Hub에
# 버전 확인하러 나가는 걸 건너뛴다. 새 모델을 처음 받아야 하면 이 줄을 빼거나 0으로.
# HF_HUB_OFFLINE=1

# tryon 워커 전용. VLM/FLUX 텍스트인코더 4bit 양자화 결과를 캐싱하는 위치, 생략 시 기본값
# (worker/.cache/quantized) 사용(CH022).
# WORKER_QUANT_CACHE_DIR=/path/to/worker/.cache/quantized
