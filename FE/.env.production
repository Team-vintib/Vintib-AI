# 배포(프로덕션) 빌드 전용 환경변수. `vite build`(production 모드)가 자동으로 읽는다.
# Caddy 뒤 같은 도메인에서 서빙되므로 API 는 상대경로 /api 로 붙는다 (CORS 불필요).
VITE_API_BASE_URL=/api
# 라이브 목록 실 API (기본 on)
VITE_LIVE_LIST_API_ENABLED=true
# 라이브 상세 + 실시간(채팅·반응·시청자 수) 실 API 연결 (BE 배포·검증 완료)
VITE_LIVE_WATCH_API_ENABLED=true
# AI 시착 프로필 실 API 연결
VITE_TRYON_API_ENABLED=true
VITE_WISH_API_ENABLED=true
VITE_MY_API_ENABLED=true
# 상품등록 AI 가격 추천 mock 그래프를 main에서도 보이도록 임시로 꺼둠(요청에 따른 조치).
# 실 BE 연동(515f89e0/38fcf252)을 일시적으로 되돌리는 것 — priceEstimateSnapshot이 항상
# null이 되어 상품 상세의 저장된 가격 추천 스냅샷 표시가 비게 된다. 실 연동을 다시 켜려면
# 이 값을 true로 되돌리면 된다.
VITE_PRODUCT_AI_ENABLED=false