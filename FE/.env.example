VITE_API_BASE_URL=https://i15a108.p.ssafy.io/api
# false로 명시할 때만 mock 목록을 사용합니다.
VITE_LIVE_LIST_API_ENABLED=true
# 라이브 시청 상세와 실시간(채팅·반응·시청자 수) 실 API 연결. 'true'가 아니면 mock으로 동작합니다.
VITE_LIVE_WATCH_API_ENABLED=true
VITE_POINT_API_ENABLED=true
VITE_WISH_API_ENABLED=true
VITE_MY_API_ENABLED=true
VITE_TRYON_API_ENABLED=false
# 상품 등록 시 사진 기반 AI 자동 분석(카테고리/색상/품질 검증). 엔드포인트가 아직 없어 기본은 mock입니다.
VITE_PRODUCT_AI_ENABLED=false
