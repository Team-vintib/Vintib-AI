# 이 파일을 .env 로 복사해서 사용한다 (.env 는 git 추적 대상이 아니다).
#   cp .env.example .env
# 운영(EC2) 값은 레포에 커밋하지 않고 GitLab CI/CD Variables 로 주입한다.

# ---------- PostgreSQL ----------
DB_NAME=vintage_auction
DB_USERNAME=postgres
DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
DB_PORT=5432

# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
REDIS_PORT=6379

# ---------- Spring Boot ----------
# local | prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- FastAPI (AI) ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
AI_PORT=8000

# ---------- 이미지 태그 ----------
# CD 파이프라인(-262)에서 커밋 SHA 등으로 덮어쓴다. 롤백 시 직전 태그로 재기동.
IMAGE_TAG=local
