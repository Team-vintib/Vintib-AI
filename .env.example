# 이 파일을 .env 로 복사해서 사용한다 (.env 는 git 추적 대상이 아니다).
#   cp .env.example .env
# 운영(EC2) 값은 레포에 커밋하지 않고 GitLab CI/CD Variables 로 주입한다.

# ---------- PostgreSQL ----------
DB_NAME=vintib
DB_USERNAME=postgres
DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
DB_PORT=5432

# ---------- pgvector (AI 전용 RAG 저장소, S15P11A108-375) ----------
# 위 postgres(BE 공유 DB)와 별개 인스턴스. AI 게이트웨이만 접속한다.
VECTOR_DB_NAME=vintib_rag
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음). 5432는 위 postgres가
# 이미 쓰므로 5433.
VECTOR_DB_PORT=5433

# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
REDIS_PORT=6379

# ---------- Spring Boot ----------
# local | prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- FastAPI (AI) ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
AI_PORT=8000
# 워커(로컬 노트북)가 poll/result/upload-* 호출 시 보내는 X-API-Key 값과 정확히 일치해야 한다.
# 운영에서는 반드시 무작위 값으로 교체 (예: openssl rand -hex 32)
WORKER_API_KEY=
# AI가 생성한 결과 URL의 베이스. 로컬 개발이 아니면 보통 안 건드린다(운영은
# docker-compose.yml의 ai 서비스에 고정값으로 박혀 있어 이 변수를 안 거친다).
PUBLIC_BASE_URL=https://i15a108.p.ssafy.io
# 가격 책정(app/pricing/)이 시세를 검색할 때 쓰는 SSAFY 공용 게이트웨이 키.
# **비워 두면 mock 백엔드로 동작한다** — 실시세가 필요할 때만 채운다.
# ⚠️ 팀 공용 유료 쿼터이고 LLM 웹검색은 별도 과금이다. 켜 두면 요청마다 비용이 발생한다.

# --- validation/pricing-model-check/ 전용 GMS 키 (서비스 런타임은 위 GMS_API_KEY를 쓴다) ---
# 가격 책정 모델 검증 스파이크만 쓴다. 없으면 mock 백엔드로 폴백한다.
GMS_API_KEY=
# NAVER_CLIENT_ID/SECRET은 validation 스파이크뿐 아니라 **서비스 런타임에서도 쓴다** —
# app/pricing/의 naver retail 백엔드가 이 키로 신상품(정가)을 조회한다. 비어 있으면 mock
# 백엔드로 폴백해 서비스는 정상 기동한다. 무료지만 쿼터가 있어 채우는 건 의도적 행위여야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 이미지 태그 ----------
# CD 파이프라인(-262)에서 커밋 SHA 등으로 덮어쓴다. 롤백 시 직전 태그로 재기동.
IMAGE_TAG=local

# ---------- 이메일 인증 (Gmail SMTP) ----------
# MAIL_USERNAME: 발신용 Gmail 주소
# MAIL_PASSWORD: 구글 계정 비밀번호가 아니라 "앱 비밀번호"(App Password) — 2단계 인증(2-Step
#   Verification) 켠 뒤 https://myaccount.google.com/apppasswords 에서 16자리로 발급
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- JWT ----------
# JWT_SECRET: 운영에서는 반드시 무작위 값으로 교체 (예: openssl rand -base64 48)
JWT_SECRET=
# Access/Refresh 토큰 유효기간 (ms). 기본값: 15분 / 14일
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000