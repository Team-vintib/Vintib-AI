# 이 파일을 .env 로 복사해서 사용한다 (.env 는 git 추적 대상이 아니다).
#   cp .env.example .env
# 운영(EC2) 값은 레포에 커밋하지 않고 GitLab CI/CD Variables 로 주입한다.

# ---------- PostgreSQL ----------
DB_NAME=vintib
DB_USERNAME=postgres
DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
DB_PORT=5432

# ---------- pgvector (AI 전용 RAG 저장소, S15P11A108-375) ----------
# 위 postgres(BE 공유 DB)와 별개 인스턴스. AI 게이트웨이만 접속한다.
VECTOR_DB_NAME=vintib_rag
VECTOR_DB_USERNAME=postgres
VECTOR_DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음). 5432는 위 postgres가
# 이미 쓰므로 5433.
VECTOR_DB_PORT=5433

# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
REDIS_PORT=6379

# ---------- Spring Boot ----------
# local | prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- FastAPI (AI) ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
AI_PORT=8000
# 워커(로컬 노트북)가 poll/result/upload-* 호출 시 보내는 X-API-Key 값과 정확히 일치해야 한다.
# 운영에서는 반드시 무작위 값으로 교체 (예: openssl rand -hex 32)
WORKER_API_KEY=
# AI가 생성한 결과 URL의 베이스. 로컬 개발이 아니면 보통 안 건드린다(운영은
# docker-compose.yml의 ai 서비스에 고정값으로 박혀 있어 이 변수를 안 거친다).
PUBLIC_BASE_URL=https://i15a108.p.ssafy.io
# 가격 책정(app/pricing/)이 시세를 검색할 때 쓰는 SSAFY 공용 게이트웨이 키.
# **비워 두면 mock 백엔드로 동작한다** — 실시세가 필요할 때만 채운다.
# ⚠️ 팀 공용 유료 쿼터이고 LLM 웹검색은 별도 과금이다. 켜 두면 요청마다 비용이 발생한다.

# --- validation/pricing-model-check/ 전용 GMS 키 (서비스 런타임은 위 GMS_API_KEY를 쓴다) ---
# 가격 책정 모델 검증 스파이크만 쓴다. 없으면 mock 백엔드로 폴백한다.
GMS_API_KEY=
# NAVER_CLIENT_ID/SECRET은 validation 스파이크뿐 아니라 **서비스 런타임에서도 쓴다** —
# app/pricing/의 naver retail 백엔드가 이 키로 신상품(정가)을 조회한다. 비어 있으면 mock
# 백엔드로 폴백해 서비스는 정상 기동한다. 무료지만 쿼터가 있어 채우는 건 의도적 행위여야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 이미지 태그 ----------
# CD 파이프라인(-262)에서 커밋 SHA 등으로 덮어쓴다. 롤백 시 직전 태그로 재기동.
IMAGE_TAG=local

# ---------- 이메일 인증 (Gmail SMTP) ----------
# MAIL_USERNAME: 발신용 Gmail 주소
# MAIL_PASSWORD: 구글 계정 비밀번호가 아니라 "앱 비밀번호"(App Password) — 2단계 인증(2-Step
#   Verification) 켠 뒤 https://myaccount.google.com/apppasswords 에서 16자리로 발급
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- JWT ----------
# JWT_SECRET: 운영에서는 반드시 무작위 값으로 교체 (예: openssl rand -base64 48)
JWT_SECRET=
# Access/Refresh 토큰 유효기간 (ms). 기본값: 15분 / 14일
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# ---------- 영상 (OpenVidu v3 / LiveKit) ----------
# 미디어 서버 API key/secret. **백엔드와 livekit 컨테이너가 같은 값을 써야 한다** —
# 어긋나면 토큰 서명 검증이 전부 실패하고 브라우저가 방송에 못 붙는다.
# 운영 값은 반드시 교체: openssl rand -base64 36
OPENVIDU_API_KEY=devkey
OPENVIDU_API_SECRET=devsecret-change-me-at-least-32-chars

# 브라우저가 붙을 주소. 응답에 그대로 실려 FE 로 나간다.
#   로컬 : ws://localhost:7880   (livekit 컨테이너 포트를 직접 연다)
#   운영 : wss://i15a108.p.ssafy.io  (Caddy 가 /rtc·/twirp 를 프록시)
OPENVIDU_SERVER_URL=ws://localhost:7880

# 백엔드가 room 관리 API 를 호출할 주소. 도커 네트워크 내부 주소다.
# 비우면 OPENVIDU_SERVER_URL 을 쓴다 — 운영에서는 반드시 내부 주소로 둘 것.
OPENVIDU_API_URL=http://livekit:7880

# 발급 토큰 수명. 방송이 이보다 길면 FE 가 재발급받는다.
OPENVIDU_TOKEN_TTL=2h

# 로컬에서 host 에 노출할 시그널링 포트 (override 전용)
LIVEKIT_PORT=7880

# ⚠️ 운영 전용 — EC2 공인 IP. 비우면 컨테이너가 사설 IP(172.x)를 ICE 후보로 뿌려
#    브라우저가 미디어에 붙지 못한다(화면이 검게 나오고 에러는 안 난다).
LIVEKIT_NODE_IP=

# ---------- 택배 배송 조회 (deliveryapi.co.kr) ----------
# 비워두면 DeliveryTrackingClient가 구독을 시도하지 않고 즉시-확정 폴백으로 동작한다
# (로컬/CI에서는 비워둬도 된다). endpoint-id는 POST /v1/webhooks/endpoints를 수동으로
# 한 번 호출해서 얻은 값을 넣는다(앱이 대신 등록하지 않음).
DELIVERY_API_KEY=
DELIVERY_API_SECRET_KEY=
DELIVERY_API_ENDPOINT_ID=
DELIVERY_API_WEBHOOK_SECRET=

# ---------- 포인트 충전 (토스페이먼츠 결제위젯) ----------
# 비워두면 결제 승인(confirm) 호출이 그대로 실패한다(delivery-api와 달리 폴백이 없다 —
# 결제는 실패를 조용히 넘기면 안 되는 영역이라 자격증명 없이 충전 자체가 동작하지 않는 게 맞다).
# 로컬 개발은 토스 개발자센터에서 발급하는 테스트 키(test_sk_.../test_ck_...)를 쓴다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=