# 이 파일을 .env 로 복사해서 사용한다 (.env 는 git 추적 대상이 아니다).
#   cp .env.example .env
# 운영(EC2) 값은 레포에 커밋하지 않고 GitLab CI/CD Variables 로 주입한다.

# ---------- PostgreSQL ----------
DB_NAME=vintib
DB_USERNAME=postgres
DB_PASSWORD=postgres
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
DB_PORT=5432

# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
# ---------- Redis ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
REDIS_PORT=6379

# ---------- Spring Boot ----------
# local | prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- FastAPI (AI) ----------
# 로컬에서 host 에 노출할 포트 (override 전용, 운영에서는 열리지 않음)
AI_PORT=8000

# ---------- 이미지 태그 ----------
# CD 파이프라인(-262)에서 커밋 SHA 등으로 덮어쓴다. 롤백 시 직전 태그로 재기동.
IMAGE_TAG=local

# ---------- 이메일 인증 (Gmail SMTP) ----------
# MAIL_USERNAME: 발신용 Gmail 주소
# MAIL_PASSWORD: 구글 계정 비밀번호가 아니라 "앱 비밀번호"(App Password) — 2단계 인증(2-Step
#   Verification) 켠 뒤 https://myaccount.google.com/apppasswords 에서 16자리로 발급
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- JWT ----------
# JWT_SECRET: 운영에서는 반드시 무작위 값으로 교체 (예: openssl rand -base64 48)
JWT_SECRET=
# Access/Refresh 토큰 유효기간 (ms). 기본값: 15분 / 14일
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000