SERVER_PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vintib
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

# --- 가격 책정 ---
# GMS_API_KEY는 **서비스 런타임에서도 쓴다** — app/pricing/의 llm_web_search comps 백엔드가
# 이 키로 시세를 검색한다(운영 컨테이너에는 docker-compose.yml의 environment: 로 주입).
# 비워 두면 mock 백엔드로 떨어지고 서비스는 정상 기동한다.
# ⚠️ 팀 공용 유료 쿼터 + LLM 웹검색 별도 과금. 채우는 건 의도적 행위여야 한다.
GMS_API_KEY=
# 아래 둘은 validation/pricing-model-check/ 전용이다. 프로토타입 서비스는 네이버를 쓰지 않는다
# (V2 실측: 네이버 comps의 중고 비율이 5%라 중고 시세 소스로 부적합 — 정가 앵커는 후속 과제).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
