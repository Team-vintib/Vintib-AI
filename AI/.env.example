SERVER_PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vintib
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

# --- 가격 책정 ---
# GMS_API_KEY는 **서비스 런타임에서도 쓴다** — app/pricing/의 llm_web_search comps 백엔드가
# 이 키로 시세를 검색한다(운영 컨테이너에는 docker-compose.yml의 environment: 로 주입).
# 비워 두면 mock 백엔드로 떨어지고 서비스는 정상 기동한다.
# ⚠️ 팀 공용 유료 쿼터 + LLM 웹검색 별도 과금. 채우는 건 의도적 행위여야 한다.
GMS_API_KEY=
# NAVER_CLIENT_ID/SECRET도 **서비스 런타임에서도 쓴다** — app/pricing/의 naver retail
# 백엔드가 이 키로 신상품(정가)을 조회한다(V2 실측: 네이버 comps의 중고 비율이 5%라 중고
# 시세 소스로는 부적합해 신상품가 조회로 재배치했다).
# 비워 두면 mock 백엔드로 떨어지고 서비스는 정상 기동한다.
# ⚠️ 무료지만 쿼터가 있다. 채우는 건 의도적 행위여야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SERPAPI_KEY는 검증 스파이크 전용이다 — 서비스 런타임(app/pricing/)은 아직 이 키를 쓰지
# 않는다. validation/PRICE/google-lens-check/google_lens_price_check.ipynb (CH005 실측)가
# 이 값을 읽는다.
# ⚠️ GMS/네이버와 달리 **완전히 유료인 서드파티**다(Free 250건/월, 이후 유료). 채우고
# 실행하는 것은 항상 사용자가 직접 한다 — Claude는 이 키를 쓰는 코드를 실행하지 않는다.
SERPAPI_KEY=
